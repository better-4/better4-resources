typedef struct
{
    uint funcSection;
    uint funcOffset;
    uint strPointer;

    local uint oldOff = FTell();
    FSeek(strPointer);
    string str;
    FSeek(oldOff);

} funcThing <read=ReadFuncThing>;

string ReadFuncThing(funcThing &thing)
{
    local string s;

    return SPrintf(s, "[%d, 0x%08x] %s", thing.funcSection, thing.funcOffset, thing.str);
}

LittleEndian();

local uint firstStr = 0;
local int i;

while (firstStr == 0 || (firstStr > 0 && FTell() < firstStr))
{
    funcThing things <optimize=false>;

    if (firstStr == 0)
        firstStr = things.strPointer;
}