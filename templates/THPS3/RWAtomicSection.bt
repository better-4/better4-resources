//------------------------------------------------
// AtomicSection data.
//------------------------------------------------

typedef struct
{
    float x;
    float y;
    float z;
} AtomicVertex <read=Str("%f, %f, %f", x, y, z)>;

typedef struct
{
    ubyte r;
    ubyte g;
    ubyte b;
    ubyte a;
} AtomicVertexColor <read=Str("%d, %d, %d, %d", r, g, b, a)>;

typedef struct
{
    float u;
    float v;
} AtomicTexCoord <read=Str("%f, %f", u, v)>;

typedef struct
{
    float u;
    float v;
} AtomicUnk <read=Str("%f, %f", u, v)>;

typedef struct
{
    ushort material;
    ushort indices[3];
} AtomicTriangle <read=Str("Mat %d: %d, %d, %d", material, indices[0], indices[1], indices[2])>;

typedef struct
{
    uint a;
    uint triangle_count;
    uint vertex_count;
    float min_x;
    float min_y;
    float min_z;
    float max_x;
    float max_y;
    float max_z;
    uint zeroA;
    uint zeroB;
    
    LastAtomicTriangleCount = triangle_count;
    LastAtomicVertexCount = vertex_count;
    
    if (vertex_count)
    {
        AtomicVertex vertices[vertex_count] <bgcolor=0xFFAAAA>;
        
        if (vertex_count && (CurrentWorldFlags & WORLDFLAG_FACE_UNK))
            uint world_unks[vertex_count];
        
        AtomicVertexColor colors[vertex_count] <bgcolor=0xFFAAAA>;
        AtomicTexCoord coords[vertex_count] <bgcolor=0xFFAAAA>;
        AtomicUnk unks[vertex_count] <bgcolor=0xFFAAAA>;
    }
    if (triangle_count)
        AtomicTriangle tris[triangle_count] <bgcolor=0xFFAAAA>;
} RWAtomicSection;